{
  "$schema": "https://api.cloudflare.com/client/schema.json",
  "name": "spill-app",
  "main": "out/index.html",
  "pages-deployments-enabled": true,
  "compatibility_flags": ["jsx-runtime", "react-19"],
  "routes": [
    "/*"
  ],
  "regions": ["iad"],
  "workers_dev_mode": true,
  "env": {
    "NEXT_PUBLIC_SITE_URL": {
      "value_type": "env_var"
    }
  },
  "vars": {},
  "compatibility_date": "2024-07-08"
}
