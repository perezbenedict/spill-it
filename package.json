{
  "name": "spill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:load": "node scripts/test-isolated.mjs --load-only",
    "load:submissions": "node scripts/load-submissions.mjs",
    "cf-build": "next build && opennextjs-cloudflare build",
    "cf-bundle": "npm exec -- wrangler build --config wrangler.build.toml && sed -e 's/from \"async_hooks\"/from \"node:async_hooks\"/g' -e 's/from \"assert\"/from \"node:assert\"/g' -e 's/from \"buffer\"/from \"node:buffer\"/g' -e 's/from \"crypto\"/from \"node:crypto\"/g' -e 's/from \"path\"/from \"node:path\"/g' -e 's/from \"stream\"/from \"node:stream\"/g' -e 's/from \"url\"/from \"node:url\"/g' -e 's/from \"util\"/from \"node:util\"/g' -e 's/from \"zlib\"/from \"node:zlib\"/g' dist/worker.js > .open-next/_worker.js && node scripts/patch-assets.mjs && cp -r .open-next/assets/* .open-next/"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "clsx": "^2.1.1",
    "framer-motion": "^12.7.4",
    "lucide-react": "^0.507.0",
    "motion": "^14.9.0",
    "next": "^15.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "glob": { ".": "^14.0.4", "minimatch": "^11.0.5" },
    "@typescript-eslint/typescript-estree": { "minimatch": "^11.0.5" }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.7",
    "vite": "^7.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.154.0"
  }
}
